
SEARCH_URLS=https://kamernet.nl/en/for-rent/apartment-eindhoven,https://www.pararius.com/apartments/eindhoven,https://www.funda.nl/zoeken/huur?selected_area=%5B%22eindhoven%22%5D,https://www.vesteda.com/nl/huurwoningen-eindhoven,https://www.vbtverhuurmakelaars.nl/huurwoningen-eindhoven,https://www.rotsvast.nl/woningaanbod/huur/eindhoven/,https://nmgwonen.nl/huurwoningen/eindhoven/,https://www.huurwoningen.nl/in/eindhoven/,https://www.huislijn.nl/huurwoningen/nederland/noord-brabant/eindhoven,https://rentfinder.nl,https://directwonen.nl/huurwoningen-huren/eindhoven
PROBE_URLS=https://www.pararius.com/apartments/eindhoven,https://www.funda.nl/zoeken/huur?selected_area=%5B%22eindhoven%22%5D,https://www.huurwoningen.nl/in/eindhoven/,https://kamernet.nl/en/for-rent/apartment-eindhoven,https://directwonen.nl/huurwoningen-huren/eindhoven,https://www.huislijn.nl/huurwoningen/nederland/noord-brabant/eindhoven,https://www.vesteda.com/nl/huurwoningen-eindhoven,https://rentfinder.nl
MAX_RENT=1150
MIN_SIZE=20
POLL_INTERVAL_SECONDS=300
SQLITE_PATH=data/listings.db
ENABLE_PLAYWRIGHT_FALLBACK=true
PLAYWRIGHT_STORAGE_STATE_PATH=data/playwright_state.json
# Huurwoningen.com crawl size (Playwright + many detail requests)
HUURWONINGEN_MAX_PAGES=12
HUURWONINGEN_MAX_DETAILS=220
# CI incremental scan (set INCREMENTAL_SCAN=true and SCAN_ROTATION=3 in Actions)
INCREMENTAL_SCAN=false
SCAN_ROTATION=0
RENTFINDER_MAX_PAGES=30
VESTEDA_MAX_DETAIL_PAGES=40
FUNDA_USE_API=true
FUNDA_API_MAX_PRICE=2500
FUNDA_MAX_PAGES=25
FUNDA_MAX_DETAIL_PAGES=80
VBT_WONINGEN_CACHE_TTL_SECONDS=3600
VBT_VALIDATE_WONING_URLS=true
ROTSVAST_INDEX_URL=https://www.rotsvast.nl/wp-json/wpararius/v1/property/index
NMG_MAX_PAGES=15
NMG_MAX_DETAIL_PAGES=80
GEOCODE_ENABLED=true
GEOCODE_USE_PDOK=true
SEEKERS_FEED_ENABLED=true
REDDIT_SEEKER_RSS=https://www.reddit.com/r/eindhoven/new.rss
MARKTPLAATS_SEEKER_URL=https://www.marktplaats.nl/q/eindhoven+gezocht+huur/
# Optional GPT fallback when rent/size still missing after detail fetch (gpt-4o-mini)
LISTING_LLM_MODE=missing_fields
LISTING_LLM_MODEL=gpt-4o-mini
DIRECTWONEN_MAX_PAGES=3
APPLICATION_COUNT_INTERVAL=0.12
# Mode: off | borderline (default when key set) | always
SEEKERS_LLM_MODE=borderline
SEEKERS_LLM_MODEL=gpt-4o-mini
# Reddit RSS retry when rate-limited (429)
REDDIT_SEEKER_RETRIES=3
REDDIT_SEEKER_BACKOFF=4.0
# Facebook seekers: local only — python -m src.seekers.facebook_local
FACEBOOK_SEEKERS_ENABLED=false
FACEBOOK_GROUP_URLS=https://www.facebook.com/groups/woninghureneindhoven,https://www.facebook.com/groups/eindhoventehuur
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
